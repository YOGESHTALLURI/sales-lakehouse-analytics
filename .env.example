# =============================================================================
# Environment contract — copy to `.env` and adjust for your machine.
#
#   cp .env.example .env
#
# Every value below is a non-secret local placeholder. `.env` is git-ignored;
# never commit real credentials. Docker Compose reads `.env` automatically, so
# this file is the single source of truth for service configuration.
# =============================================================================

# ─── PostgreSQL — OLTP only ──────────────────────────────────────────────────
# Records customers, products, orders, order_items and pipeline_runs.
# Analytics endpoints must never read from here.
POSTGRES_DB=sales
POSTGRES_USER=sales_app
POSTGRES_PASSWORD=local_dev_password_change_me
# Host name/port used by containers on the Compose network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Port published on the host. 55432 avoids clashing with a local PostgreSQL.
POSTGRES_HOST_PORT=55432

# ─── MinIO — immutable raw data lake ─────────────────────────────────────────
# Stores run-partitioned raw Parquet extracts. Objects are append-only.
MINIO_ROOT_USER=local_minio_user
MINIO_ROOT_PASSWORD=local_minio_password_change_me
# S3 endpoint as seen from inside the Compose network.
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
# Ports published on the host: S3 API and the MinIO console.
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# Lake bucket and the prefix under which raw runs are written:
#   s3://${LAKE_BUCKET}/${LAKE_RAW_PREFIX}/run_date=<date>/run_id=<uuid>/
LAKE_BUCKET=sales-lake
LAKE_RAW_PREFIX=raw

# ─── DuckDB — analytical warehouse ───────────────────────────────────────────
# A single file on the shared `warehouse-data` volume. The ETL publishes it
# atomically; the API opens it read-only.
WAREHOUSE_DIR=/warehouse
WAREHOUSE_FILE=sales.duckdb
WAREHOUSE_PATH=/warehouse/sales.duckdb

# ─── API (Express) ───────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_HOST_PORT=4000
LOG_LEVEL=info
# Not currently read by the API: no CORS middleware exists, and none is needed.
# The web container's nginx reverse-proxies /api and /health to this service, so
# the browser only ever sees nginx's origin. Kept here in case a future deployment
# serves the web app from a genuinely separate origin.
CORS_ORIGIN=http://localhost:5173

# ─── Web (React + Vite) ──────────────────────────────────────────────────────
# Host port nginx is published on inside the container build. The frontend has no
# base-URL variable to set: it only ever calls relative /api and /health paths,
# proxied to the api service by apps/web/nginx.conf (or by Vite's dev proxy —
# see apps/web/.env.example — when running `npm run dev` outside Docker).
WEB_HOST_PORT=5173

# ─── Synthetic data generator ────────────────────────────────────────────────
# All business data is generated by this repository, never downloaded. These
# five values plus data/postgres/seeds/ fully determine the dataset: the same
# settings produce a byte-identical result on any machine and OS.
SEED_RANDOM_SEED=20260818
SEED_CUSTOMERS=500
SEED_PRODUCTS=100
SEED_ORDERS=10000
SEED_MONTHS=12
# Last day of generated order history, inclusive. A fixed anchor rather than
# "today" on purpose: anchoring to the clock would change the dataset daily and
# destroy reproducibility. Move it forward to shift the whole window.
SEED_END_DATE=2026-08-18
