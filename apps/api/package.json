{
  "name": "@sales-lakehouse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API: operational sales endpoints and warehouse-backed analytics",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "serve": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/seed/seed-cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
