# ─── apps/web environment contract ───────────────────────────────────────────
# Vite loads .env files from this directory. Copy to `.env.local` to override;
# `.env*` is git-ignored, so never put anything secret here either.

# Serve the UI from contract fixtures instead of the live API.
#
# Defaults to `1` while Phases 3 and 4 are in flight, because /api/analytics/*
# and /api/pipeline/* do not exist yet. Set to `0` once they are merged; that is
# the only change required to run the whole UI against the real backend.
VITE_API_FIXTURES=1

# Where the Vite dev proxy forwards /api and /health. Matches API_HOST_PORT in
# the root .env.example.
VITE_API_PROXY_TARGET=http://localhost:4000
